<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="برنامج الوافي"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"
            android:layout_marginTop="22dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="للكتابة والشعر"
            android:textSize="17sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp"/>

        <Button
            android:id="@+id/newTextButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="✍ كتابة قصيدة أو نص جديد"
            android:textSize="17sp"/>

        <Button
            android:id="@+id/myTextsButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="📚 قصائدي ونصوصي"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/searchButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🔎 البحث في كتاباتي"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/poetryButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🎼 أدوات الشعر"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/aiButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🤖 مساعد الوافي الذكي"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الوافي 2.0 — النسخة التجريبية"
            android:gravity="center"
            android:textColor="#999999"
            android:layout_marginTop="30dp"/>
    </LinearLayout>
</ScrollView>
